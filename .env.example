# Copiar a .env y cambiar TODAS las claves. El .env real no se sube al repositorio.
#   openssl rand -hex 16     # sirve para generar cada valor

PERIODO_S=15                 # segundos entre muestras de cada nodo

MQTT_USER=ambiental
MQTT_PASS=cambiar-esta-clave

AMQP_USER=ambiental
AMQP_PASS=cambiar-esta-clave

INFLUX_USER=admin
INFLUX_PASS=cambiar-esta-clave-min-8
INFLUX_TOKEN=cambiar-este-token-largo

GRAFANA_USER=admin
GRAFANA_PASS=cambiar-esta-clave

# Interfaces donde se publican MQTT (tcp/1883) y CoAP (udp/5683) fuera de Docker.
# 127.0.0.1 = solo la propia VM. Poner 0.0.0.0 unicamente si un dispositivo externo
# (ESP32, Raspberry Pi) va a publicar, y abrir ese puerto en el firewall/NSG.
BIND_MQTT=127.0.0.1
BIND_COAP=127.0.0.1
